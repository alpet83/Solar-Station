# Локальные снятые с хоста снимки /tmp (диагностика, не для репозитория)
.tmp/
/sbin/__pycache__

# Реальные конфиги/секреты хоста: в репозитории только *.example с заглушками
/etc/*.json
/etc/*.conf
*.pass
*.secret

# Разовые диффы/патчи для сравнения с хостом: не для репозитория
*.diff
*.patch
*.orig
*.bak
