# Пример unit-файла для eybond_tap (прозрачный tap даталоггера SmartESS/Eybond).
# По умолчанию НЕ включён. Использование:
#   sudo cp eybond-tap.service /etc/systemd/system/ && sudo systemctl daemon-reload
#   sudo systemctl start eybond-tap     # разово, для захвата трафика
#   sudo systemctl enable eybond-tap    # только если нужен постоянный запуск
# Поправьте пути, порты и --upstream под свою установку.
[Unit]
Description=Eybond datalogger transparent TCP tap
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/solar-station/sbin/eybond_tap.py --listen 0.0.0.0:502 --upstream ess.eybond.com:502 --dns 8.8.8.8 --log /var/log/eybond-tap.log
Restart=on-failure
RestartSec=5
# порт <1024 требует привилегий; вместо root можно выдать capability
AmbientCapabilities=CAP_NET_BIND_SERVICE
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
# DynamicUser: лог в /var/log недоступен на запись без User= и прав на файл; при проблемах задайте User=/LogsDirectory=
ReadWritePaths=/var/log

[Install]
WantedBy=multi-user.target
