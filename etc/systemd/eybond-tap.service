# Пример unit-файла для eybond_tap (прозрачный tap даталоггера SmartESS/Eybond).
# По умолчанию НЕ включён. Использование:
#   sudo cp eybond-tap.service /etc/systemd/system/ && sudo systemctl daemon-reload
#   sudo systemctl start eybond-tap     # разово, для захвата трафика
#   sudo systemctl enable eybond-tap    # только если нужен постоянный запуск
# Поправьте пути под свою установку; порты и upstream - в /etc/eybond-tap.conf.
[Unit]
Description=Eybond datalogger transparent TCP tap
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# все параметры (listen/upstream/dns/log, battery guard, трекер ритма опроса) - в JSON-конфиге,
# см. etc/eybond-tap.conf.example; "guard": false выключает guard. Нет файла или ошибка в нём -> сервис не стартует
# (причина в journalctl). Флаги командной строки при необходимости перекрывают конфиг.
ExecStart=/usr/bin/python3 /opt/solar-station/sbin/eybond_tap.py --config /etc/eybond-tap.conf
Restart=on-failure
RestartSec=5
# порт <1024 требует привилегий; вместо root можно выдать capability
AmbientCapabilities=CAP_NET_BIND_SERVICE
DynamicUser=yes
RuntimeDirectory=eybond-tap
NoNewPrivileges=yes
ProtectSystem=strict
# DynamicUser: каталог лога создаёт и отдаёт сервису systemd: /var/log/eybond-tap/ (в конфиге "log": "/var/log/eybond-tap/eybond-tap.log")
LogsDirectory=eybond-tap

[Install]
WantedBy=multi-user.target
